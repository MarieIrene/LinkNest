# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/linknest?schema=public"
# For Neon: end the URL with ?sslmode=require&connect_timeout=30&pool_timeout=30 (no channel_binding)

# Secret used to sign login sessions. Use 32+ random characters.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string-of-32-chars"

# Public address of the app, used to build shareable links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Emails (comma-separated) of LinkNest staff who can see card bookings at /dashboard/bookings
ADMIN_EMAILS=""

# Email for "Forgot password" links. Option 1, Gmail: the Gmail address and a 16-letter
# Google app password (https://myaccount.google.com/apppasswords), NOT the normal password.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Option 2, Resend (https://resend.com). Leave everything empty in development:
# reset links are then printed in the terminal instead.
RESEND_API_KEY=""
EMAIL_FROM="LinkNest <no-reply@arvash.com>"
