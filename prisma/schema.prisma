generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  displayName  String?
  bio          String?
  avatarUrl    String?
  views        Int      @default(0)
  /// Times someone opened the profile by tapping the NFC card (via /c/:id).
  cardTaps     Int      @default(0)
  /// Set by an admin: hides the public page and card link.
  suspended    Boolean  @default(false)
  /// Contact details shown on the public page and in "Save contact". Empty = hidden.
  jobTitle     String?
  company      String?
  phone        String?
  whatsapp     String?
  publicEmail  String?
  location     String?
  /// Times someone downloaded this person's contact card (.vcf).
  contactSaves Int      @default(0)
  cards        Card[]
  links        Link[]
  resetTokens  PasswordResetToken[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Link {
  id        String   @id @default(cuid())
  title     String
  url       String
  /// Which icon to show: instagram, linkedin, whatsapp, website… (see src/lib/platforms.tsx)
  platform  String   @default("website")
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  clicks    Int      @default(0)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, position])
}

/// A request from the landing page to order a smart card or social media tag.
model Booking {
  id        String   @id @default(cuid())
  product   String
  quantity  Int      @default(1)
  name      String
  phone     String
  email     String?
  message   String?
  /// new, confirmed, paid, ready, delivered or declined (see src/lib/bookings.ts)
  status    String   @default("new")
  /// Staff notes, e.g. payment reference. Never shown to the customer.
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([createdAt])
  @@index([status])
}

/// One-time link for "Forgot password". Only a hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// A physical NFC card or tag. Its short code is what gets written onto the chip: /c/CODE.
/// Cards can exist before they're given to anyone (stock), and can be switched off if lost.
model Card {
  id        String    @id @default(cuid())
  code      String    @unique
  /// business-card or social-tag (see src/lib/products.ts)
  type      String    @default("business-card")
  /// Optional note, e.g. "Matte black, batch 3"
  label     String?
  /// active or disabled (lost/stolen/replaced)
  status    String    @default("active")
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  taps      Int       @default(0)
  lastTapAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([userId])
}
